# .env.example — required environment variables (real values live in the root .env, never committed).
# This file documents keys added by the fuel-forecast feature. The backend also reads the
# existing DB/R2/Auth0/SMTP keys already provisioned in .env (not duplicated here).

# --- Fuel-forecast product (Plan 1) ------------------------------------------
FUEL_FORECAST_DB=postgresql://user:pass@host/fuel_forecast?sslmode=require  # isolated Neon DB (fuel_* tables)
R2_BUCKET_RAW=vdv-raw   # Cloudflare R2 bucket for the Bronze landing zone (raw immutable payloads)

# The corporate API service (Plan 4) does NOT use this file — it loads its own
# secrets from .corp-prod-env (separate, higher-isolation). See docs/research/fuel-price-forecast-design.md §7.

# --- GA4 Reporting API (website traffic in /pages/admin.html) ---------------
# Auth is a personal OAuth refresh token, NOT a service-account key — this GCP
# project has the org policy `iam.disableServiceAccountKeyCreation` enforced,
# which blocks service-account key downloads. See be/core/ga4.py and
# CLAUDE.md "GA4 Reporting API" for the one-time setup script that produces
# these 4 values (OAuth client "Desktop app" + a one-time browser consent).
GA4_PROPERTY_ID=522974314                          # numeric GA4 property id, not the G-XXXX measurement id
GA4_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GA4_OAUTH_CLIENT_SECRET=xxxxx
GA4_OAUTH_REFRESH_TOKEN=xxxxx                       # long-lived; only invalidated if access is revoked in Google Account settings
