# PRIMARY gold/silver crawl schedule — every 2 hours across VN office hours.
#
# 01:00 UTC = 08:00 VN … 09:00 UTC = 16:00 VN. SJC adjusts its quote a handful of
# times on a normal trading day, so 5 passes track the moves without hammering the
# source. The old schedule fired twice (01:45 + 03:00 UTC) and only when the day's
# rows were still missing — see crawl-fallback.sh for why that guard is gone.
#
# Round minutes are fine here, unlike GitHub Actions: this box runs the unit at the
# time asked. The `:07`-style odd minutes elsewhere in this repo exist purely to
# dodge GitHub's congested scheduling slots, which do not apply to systemd.
[Unit]
Description=Timer for the Viet Dataverse gold/silver crawl (primary path)

[Timer]
OnCalendar=*-*-* 01:00:00 UTC
OnCalendar=*-*-* 03:00:00 UTC
OnCalendar=*-*-* 05:00:00 UTC
OnCalendar=*-*-* 07:00:00 UTC
OnCalendar=*-*-* 09:00:00 UTC
# Catch up after a box reboot rather than silently skipping the slot.
Persistent=true
AccuracySec=1min
Unit=crawl-fallback.service

[Install]
WantedBy=timers.target
